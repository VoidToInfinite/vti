		"eslint-plugin-react": "^7.32.2",
		"husky": "^8.0.3",
		"lint-staged": "^13.1.1",
		"prettier": "^2.8.4",
		"stylelint": "^15.1.0",
		"stylelint-config-recommended": "^10.0.1",
