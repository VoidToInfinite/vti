{
    "redirects": [
        {
            "source": "/terminos",
            "destination": "/aviso-legal",
            "statusCode": 301
        },
        { "source": "/accesibilidad", "destination": "/", "statusCode": 301 }
    ],
    "routes": [
        {
            "src": "/(.*)\\.webp",
            "headers": {
                "Cache-Control": "public, max-age=2592000, stale-while-revalidate=604800"
            },
            "continue": true
        },
        {
            "src": "/opengraph-image",
            "headers": { "Content-Type": "image/png" },
            "continue": true
        },
        { "handle": "filesystem" },
        { "src": "/en/(.*)", "status": 404, "dest": "/en/404" }
    ]
}
